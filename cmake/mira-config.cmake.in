@PACKAGE_INIT@

# Explicit components load only their dependency closure. With no components,
# retain the original convenience behaviour: expose every installed module.
set(MIRA_WITH_TLS @MIRA_ENABLE_TLS@)
set(MIRA_WITH_HTTP2 @MIRA_ENABLE_HTTP2@)
set(MIRA_WITH_HTTP3 @MIRA_ENABLE_HTTP3@)
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/miraTargets.cmake")
set(mira_core_FOUND TRUE)
set(mira_transport_FOUND TRUE)
set(mira_http_FOUND TRUE)
set(mira_tls_FOUND FALSE)
set(mira_http2_FOUND FALSE)
set(mira_quic_FOUND FALSE)
set(mira_http3_FOUND FALSE)

set(_mira_load_tls FALSE)
set(_mira_load_http2 FALSE)
set(_mira_load_http3 FALSE)
if(NOT mira_FIND_COMPONENTS)
    set(_mira_load_tls ${MIRA_WITH_TLS})
    set(_mira_load_http2 ${MIRA_WITH_HTTP2})
    set(_mira_load_http3 ${MIRA_WITH_HTTP3})
else()
    foreach(_component IN LISTS mira_FIND_COMPONENTS)
        if(_component STREQUAL "tls" AND MIRA_WITH_TLS)
            set(_mira_load_tls TRUE)
        elseif(_component STREQUAL "http2" AND MIRA_WITH_HTTP2)
            set(_mira_load_http2 TRUE)
        elseif((_component STREQUAL "quic" OR _component STREQUAL "http3") AND MIRA_WITH_HTTP3)
            set(_mira_load_http3 TRUE)
        endif()
    endforeach()
endif()

if(_mira_load_tls)
    find_dependency(OpenSSL 3.0 COMPONENTS SSL Crypto)
    include("${CMAKE_CURRENT_LIST_DIR}/miraTlsTargets.cmake")
    set(mira_tls_FOUND TRUE)
endif()
# Dependency discovery for optional protocol targets is installed alongside
# this file by the protocol modules.
if(_mira_load_http2)
    include("${CMAKE_CURRENT_LIST_DIR}/mira-http2-dependencies.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/miraHttp2Targets.cmake")
    set(mira_http2_FOUND TRUE)
endif()
if(_mira_load_http3)
    include("${CMAKE_CURRENT_LIST_DIR}/mira-http3-dependencies.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/miraHttp3Targets.cmake")
    set(mira_quic_FOUND TRUE)
    set(mira_http3_FOUND TRUE)
endif()
foreach(_component IN LISTS mira_FIND_COMPONENTS)
    if(NOT mira_${_component}_FOUND)
        set(mira_NOT_FOUND_MESSAGE
            "Mira component '${_component}' is unavailable; rebuild with its MIRA_ENABLE_* option enabled, or omit that component.")
    endif()
endforeach()
check_required_components(Mira)
unset(_component)
unset(_mira_load_tls)
unset(_mira_load_http2)
unset(_mira_load_http3)
